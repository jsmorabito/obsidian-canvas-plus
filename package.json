  "description": "Canvas tools, free text, ink and layers for Obsidian, with note cards and relations when Note Types is enabled.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
