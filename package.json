  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "pele": "^1.9.0",
    "perfect-freehand": "^1.2.3"
  }
